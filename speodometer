<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CT 100 Analog Speedometer with Slider 🏍️💨</title>
<style>
  body {
    background: #08080f;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #e0e0ff;
    font-family: 'Courier New', monospace;
    padding: 20px;
    min-height: 100vh;
    box-sizing: border-box;
  }
  h2 {
    text-shadow: 0 0 15px #00e5ff, 0 0 30px #ff007f;
    margin-bottom: 5px;
    color: #fff;
    letter-spacing: 2px;
  }
  .main-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    background: linear-gradient(135deg, #141424, #0a0a14);
    padding: 25px;
    border-radius: 20px;
    border: 2px solid #00e5ff55;
    box-shadow: 0 0 30px rgba(0, 229, 255, 0.2), inset 0 0 20px rgba(255, 0, 127, 0.1);
    max-width: 360px;
    width: 100%;
  }
  .gauge-box {
    position: relative;
    display: inline-block;
    border: 4px solid #ff007f;
    border-radius: 50%;
    padding: 5px;
    background: #000;
    box-shadow: 0 0 25px rgba(255, 0, 127, 0.5), inset 0 0 15px rgba(0, 229, 255, 0.3);
  }
  canvas {
    background: #05050a;
    border-radius: 50%;
  }
  .odometer-container {
    position: absolute;
    top: 220px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    background: #12121c;
    border: 2px solid #00e5ff88;
    border-top: 2px solid #05050a;
    border-left: 2px solid #05050a;
    padding: 3px 6px;
    border-radius: 4px;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.9), 0 0 10px rgba(0, 229, 255, 0.3);
    align-items: center;
  }
  .digit {
    width: 16px;
    height: 26px;
    overflow: hidden;
    margin: 0 1px;
    position: relative;
    font-size: 1.1em;
    font-weight: bold;
    text-align: center;
    border-left: 1px solid rgba(0,229,255,0.1);
    border-right: 1px solid rgba(255,255,255,0.1);
  }
  .digit.integer-digit {
    color: #00ffff;
    background: linear-gradient(to bottom, #1a1a2e 0%, #16213e 50%, #0f172a 100%);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
  }
  .digit.decimal-1 {
    color: #000;
    background: linear-gradient(to bottom, #ff3366, #ff0055);
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
  }
  .digit.decimal-2 {
    color: #000;
    background: linear-gradient(to bottom, #00ff88, #00cc66);
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
  }
  .digit.decimal-3 {
    color: #000;
    background: linear-gradient(to bottom, #00e5ff, #0088ff);
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
  }
  .digit.decimal-point {
    width: 8px;
    background: transparent;
    color: #ff007f;
    text-align: center;
    font-weight: bold;
    line-height: 26px;
    border: none;
    text-shadow: 0 0 8px #ff007f;
  }
  .digit span {
    display: block;
    position: absolute;
    width: 100%;
    line-height: 26px;
  }
  .control-panel {
    width: 100%;
    text-align: center;
    border-top: 1px dashed #00e5ff44;
    padding-top: 15px;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: 15px;
    font-size: 13px;
  }
  .stat-card {
    background: #0f0f1a;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #00e5ff55;
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.1);
  }
  .stat-card span {
    display: block;
    font-weight: bold;
    font-size: 18px;
    margin-top: 5px;
    color: #00ff88;
    text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
  }
  .slider-container {
    width: 100%;
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    font-size: 12px;
    color: #00e5ff;
  }
  .slider-container input[type=range] {
    -webkit-appearance: none;
    width: 100%;
    height: 10px;
    background: #0a0a14;
    border-radius: 5px;
    outline: none;
    border: 1px solid #00e5ff66;
    box-shadow: inset 0 0 5px rgba(0, 229, 255, 0.2);
  }
  .slider-container input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff007f, #ff3333);
    cursor: pointer;
    box-shadow: 0 0 15px #ff007f, 0 0 5px #fff;
  }
  .button-row {
    display: flex;
    gap: 10px;
  }
  .reset-btn {
    flex: 1;
    background: transparent;
    border: 1px solid #ff007f;
    color: #ff007f;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 0 8px rgba(255, 0, 127, 0.2);
  }
  .reset-btn:hover {
    background: #ff007f;
    color: #fff;
    box-shadow: 0 0 20px #ff007f;
  }
</style>
</head>
<body>

<h2>BAJAJ CT 100 🏍️💨</h2>
<p style="margin-top:0; color:#00e5ffaa; font-size:12px; text-shadow: 0 0 8px rgba(0,229,255,0.4);">Neon Cyberpunk Edition</p>

<div class="main-container">
  <!-- Speedo Meter Gauge Frame -->
  <div class="gauge-box" id="gaugeFrame">
    <canvas id="speedo" width="300" height="300"></canvas>
    <div class="odometer-container" id="odometer"></div>
  </div>

  <!-- Controls & Stats -->
  <div class="control-panel">
    <div class="stats-grid">
      <div class="stat-card">
        Current Speed
        <span id="speedVal">0 km/h</span>
      </div>
    </div>
    
    <div class="slider-container">
      <label for="throttleSlider">THROTTLE ACCELERATOR:</label>
      <input type="range" id="throttleSlider" min="0" max="120" value="0">
    </div>
    
    <div class="button-row">
      <button class="reset-btn" onclick="resetOdometer()">Reset Odometer ⚠️</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('speedo');
const ctx = canvas.getContext('2d');
const odoContainer = document.getElementById('odometer');
const throttleSlider = document.getElementById('throttleSlider');

const centerX = canvas.width / 2;
const centerY = canvas.height / 2;
const radius = 135;

// State Variables
let totalDistanceKM = parseFloat(localStorage.getItem('ct100_odometer')) || 0.0;
let currentSpeedKmh = 0; 
let displaySpeed = 0;
let spans = [];
const digitHeight = 26;

// Build Cascade Odometer Elements
function createOdometer(container) {
  container.innerHTML = '';
  spans = [];
  
  for (let i = 0; i < 9; i++) {
    if (i === 5) {
      const dot = document.createElement('div');
      dot.className = 'digit decimal-point';
      dot.innerText = '.';
      container.appendChild(dot);
      continue;
    }
    
    const digit = document.createElement('div');
    if (i < 5) {
      digit.className = 'digit integer-digit';
    } else if (i === 6) {
      digit.className = 'digit decimal-1';
    } else if (i === 7) {
      digit.className = 'digit decimal-2';
    } else if (i === 8) {
      digit.className = 'digit decimal-3';
    }
    
    const span = document.createElement('span');
    let nums = '';
    for(let j = 0; j <= 10; j++) nums += (j % 10) + '<br>';
    span.innerHTML = nums;
    span.style.top = '0px';
    
    digit.appendChild(span);
    container.appendChild(digit);
    spans.push(span);
  }
}

function updateOdometer(kmVal) {
  let scaled = kmVal * 1000;
  let floorScaled = Math.floor(scaled);
  
  let d7 = floorScaled % 10;              
  let d6 = Math.floor(floorScaled / 10) % 10;      
  let d5 = Math.floor(floorScaled / 100) % 10;     
  let d4 = Math.floor(floorScaled / 1000) % 10;    
  let d3 = Math.floor(floorScaled / 10000) % 10;   
  let d2 = Math.floor(floorScaled / 100000) % 10;  
  let d1 = Math.floor(floorScaled / 1000000) % 10; 
  let d0 = Math.floor(floorScaled / 10000000) % 10;
  
  let currentDigits = [d0, d1, d2, d3, d4, d5, d6, d7];
  let fraction = scaled - floorScaled;
  
  let rollProgress = new Array(8).fill(0);
  rollProgress[7] = fraction;
  
  if (currentDigits[7] === 9) rollProgress[6] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9) rollProgress[5] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9 && currentDigits[5] === 9) rollProgress[4] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9 && currentDigits[5] === 9 && currentDigits[4] === 9) rollProgress[3] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9 && currentDigits[5] === 9 && currentDigits[4] === 9 && currentDigits[3] === 9) rollProgress[2] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9 && currentDigits[5] === 9 && currentDigits[4] === 9 && currentDigits[3] === 9 && currentDigits[2] === 9) rollProgress[1] = fraction;
  if (currentDigits[7] === 9 && currentDigits[6] === 9 && currentDigits[5] === 9 && currentDigits[4] === 9 && currentDigits[3] === 9 && currentDigits[2] === 9 && currentDigits[1] === 9) rollProgress[0] = fraction;

  for (let i = 0; i < spans.length; i++) {
    let finalOffset = -(currentDigits[i] + rollProgress[i]) * digitHeight;
    spans[i].style.top = `${finalOffset}px`;
  }
}

// Render Classic CT 100 Speedometer Dial Canvas with Neon Glow Colors
function drawSpeedometer() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    let bgGrad = ctx.createRadialGradient(centerX, centerY, 20, centerX, centerY, radius);
    bgGrad.addColorStop(0, '#0f0f1f');
    bgGrad.addColorStop(1, '#020205');
    ctx.fillStyle = bgGrad;
    ctx.beginPath();
    ctx.arc(centerX, centerY, radius, 0, Math.PI*2);
    ctx.fill();

    ctx.lineWidth = 6;
    ctx.strokeStyle = "rgba(0, 229, 255, 0.2)";
    ctx.stroke();

    for(let i = 0; i <= 120; i += 5){
      let angle = Math.PI * 0.85 + (i / 120) * (Math.PI * 1.3);
      let isMajor = (i % 20 === 0);
      let isMedium = (i % 10 === 0 && !isMajor);
      let tickLength = isMajor ? 14 : (isMedium ? 10 : 6);
      
      let x1 = centerX + Math.cos(angle) * (radius - tickLength);
      let y1 = centerY + Math.sin(angle) * (radius - tickLength);
      let x2 = centerX + Math.cos(angle) * radius;
      let y2 = centerY + Math.sin(angle) * radius;
      
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.lineWidth = isMajor ? 3 : 1.5;
      
      // Color coding ticks: High speed (>=90) turns neon pink/red, low speed stays cyan/white
      if (i >= 90) {
        ctx.strokeStyle = isMajor ? '#ff007f' : '#ff3366';
      } else {
        ctx.strokeStyle = isMajor ? '#00ffff' : '#0099cc';
      }
      ctx.stroke();

      if(isMajor){
        let tx = centerX + Math.cos(angle) * (radius - 28);
        let ty = centerY + Math.sin(angle) * (radius - 28) + 4;
        ctx.font = "bold 12px 'Courier New'";
        ctx.fillStyle = i >= 90 ? '#ff007f' : '#ffffff';
        ctx.shadowColor = i >= 90 ? '#ff007f' : '#00ffff';
        ctx.shadowBlur = 6;
        ctx.textAlign = "center";
        ctx.fillText(i, tx, ty);
        ctx.shadowBlur = 0; // Reset shadow
      }
    }

    ctx.font = "bold 10px 'Courier New'";
    ctx.fillStyle = "#00ff88";
    ctx.shadowColor = "#00ff88";
    ctx.shadowBlur = 8;
    ctx.textAlign = "center";
    ctx.fillText("ECO ZONE", centerX - 45, centerY - 25);
    ctx.shadowBlur = 0;

    displaySpeed += (currentSpeedKmh - displaySpeed) * 0.15;
    let needleAngle = Math.PI * 0.85 + (Math.min(displaySpeed, 120) / 120) * (Math.PI * 1.3);
    
    ctx.save();
    ctx.shadowColor = "#ff007f";
    ctx.shadowBlur = 12;

    ctx.beginPath();
    ctx.moveTo(centerX, centerY);
    ctx.lineTo(centerX + Math.cos(needleAngle) * (radius - 22),
               centerY + Math.sin(needleAngle) * (radius - 22));
    ctx.lineWidth = 4;
    ctx.strokeStyle = '#ff007f';
    ctx.stroke();
    ctx.restore();

    ctx.beginPath();
    ctx.arc(centerX, centerY, 9, 0, Math.PI*2);
    ctx.fillStyle = "#05050a";
    ctx.fill();
    ctx.lineWidth = 2;
    ctx.strokeStyle = "#00ffff";
    ctx.shadowColor = "#00ffff";
    ctx.shadowBlur = 8;
    ctx.stroke();

    requestAnimationFrame(drawSpeedometer);
}

function resetOdometer() {
  if (confirm("Are you sure you want to reset the odometer?")) {
    totalDistanceKM = 0.0;
    localStorage.removeItem('ct100_odometer');
    updateOdometer(totalDistanceKM);
  }
}

throttleSlider.addEventListener('input', (e) => {
  currentSpeedKmh = parseFloat(e.target.value);
});

setInterval(() => {
  if (currentSpeedKmh > 0) {
    let distanceIncrement = (currentSpeedKmh / 3600) * 0.05; 
    totalDistanceKM += distanceIncrement;
    localStorage.setItem('ct100_odometer', totalDistanceKM.toFixed(4));
    updateOdometer(totalDistanceKM);
  }

  document.getElementById('speedVal').innerText = `${Math.round(displaySpeed)} km/h`;
}, 50);

// Initialization
createOdometer(odoContainer);
updateOdometer(totalDistanceKM);
drawSpeedometer();
</script>
</body>
</html>
